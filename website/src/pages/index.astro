---
import '../styles/site.css';

const base = import.meta.env.BASE_URL.endsWith('/')
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;

const heroImage = `${base}images/buggy-commands.png`;
const docsHref = `${base}docs/`;
const installHref = `${base}docs/getting-started/installation/`;
const quickstartHref = `${base}docs/getting-started/quickstart/`;

const installPaths = [
	{
		title: 'Windows',
		body: 'Run the release installer, then let doctor verify the device path before you burn time on setup drift.',
		command: `iex (irm https://github.com/digablesolutions/luotsi/releases/latest/download/luotsi-install.ps1)
luotsi doctor --device <serial> --fix`,
	},
	{
		title: 'macOS / Linux',
		body: 'Use the shell installer, then validate the same first-run path against the attached device.',
		command: `curl -fsSL https://github.com/digablesolutions/luotsi/releases/latest/download/luotsi-install.sh | sh
luotsi doctor --device <serial> --fix`,
	},
];

const workflowRoutes = [
	{
		href: `${base}docs/core-workflows/live-view/`,
		title: 'Operate the device',
		summary: 'Open live view when you need the SDL window, hotkeys, screenshots, or a shareable observer session.',
		cta: 'Use live view',
		command: 'luotsi view --device <serial>',
	},
	{
		href: `${base}docs/core-workflows/inspect-and-scenarios/`,
		title: 'Explore the UI',
		summary: 'Use inspect when an engineer or agent needs structured JSONL snapshots and command results instead of a window.',
		cta: 'Use inspect',
		command: 'luotsi inspect --device <serial>',
	},
	{
		href: `${base}docs/core-workflows/replay-and-artifacts/`,
		title: 'Replay the failure',
		summary: 'Use scenarios plus replay when the flow needs durable artifacts, reports, and a post-run triage trail.',
		cta: 'Use replay',
		command: 'luotsi run --path scenarios --device <serial>',
	},
];

const docsBuckets = [
	{
		title: 'Start Here',
		intro: 'Get from install to a stable device session before you debug the app.',
		items: [
			{ label: 'Installation', href: installHref },
			{ label: 'Quickstart', href: quickstartHref },
			{ label: 'Device Readiness', href: `${base}docs/getting-started/device-readiness/` },
			{ label: 'Troubleshooting', href: `${base}docs/getting-started/troubleshooting/` },
		],
	},
	{
		title: 'Run Workflows',
		intro: 'Choose the surface that matches the job: operator control, structured exploration, or repeatable runs.',
		items: [
			{ label: 'Live View', href: `${base}docs/core-workflows/live-view/` },
			{ label: 'Inspect and Scenarios', href: `${base}docs/core-workflows/inspect-and-scenarios/` },
			{ label: 'Scenario Playbooks', href: `${base}docs/reference/scenario-playbooks/` },
			{ label: 'Wireless and Port Forwarding', href: `${base}docs/reference/wireless-and-port-forwarding/` },
		],
	},
	{
		title: 'Debug And Integrate',
		intro: 'Use the artifact layer and command surface when the question is no longer just how to start.',
		items: [
			{ label: 'Replay and Artifacts', href: `${base}docs/core-workflows/replay-and-artifacts/` },
			{ label: 'CLI Command Groups', href: `${base}docs/reference/cli-command-groups/` },
			{ label: 'Output Envelopes', href: `${base}docs/reference/output-envelopes/` },
		],
	},
];

const proofStatus = [
	{ label: 'Device', value: 'Physical Android' },
	{ label: 'Transport', value: 'ADB + JSONL' },
	{ label: 'Artifacts', value: 'Replay-ready' },
];

const utilityLinks = [
	{ label: 'Architecture', href: `${base}docs/concepts/architecture/` },
	{ label: 'Subsystems', href: `${base}docs/concepts/subsystems/` },
	{ label: 'Contribution Guide', href: `${base}docs/contributing/guide/` },
	{ label: 'Releases', href: 'https://github.com/digablesolutions/luotsi/releases' },
	{ label: 'GitHub', href: 'https://github.com/digablesolutions/luotsi' },
];

const proofBadges = [
	{ title: 'Real device', copy: 'A physical Android screen under test, not a browser mock.' },
	{ title: 'Structured sessions', copy: 'Inspect and view emit machine-readable state instead of terminal prose.' },
	{ title: 'Replay artifacts', copy: 'Every run leaves behind a trail you can inspect after the session ends.' },
];

const inspectSnippet = [
	'{"type":"screen_snapshot","activity":"fi.systam.visit.MainActivity"}',
	'{"id":"2","command":"tap_text","text":"Sign in"}',
	'{"type":"command_result","ok":true,"artifact":"after-tap.png"}',
];

const replaySnippet = [
	'artifact_root: ./artifacts/smoke-run',
	'timeline: session-timeline.jsonl',
	'summary: session-replay.json',
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>Luotsi | Host-Driven Android Device Automation</title>
		<meta
			name="description"
			content="Luotsi is a host-driven CLI for Android device automation, inspection, live view, and artifact-rich scenario runs."
		/>
		<link rel="icon" type="image/svg+xml" href={`${base}luotsi-mark.svg`} />
	</head>
	<body>
		<main class="landing-page">
			<div class="landing-shell">
				<header class="topbar">
					<a class="brand" href={base}>
						<img src={`${base}luotsi-mark.svg`} alt="Luotsi" />
						<span class="brand__text">
							Luotsi
							<span class="brand__subtext">Host-driven Android automation</span>
						</span>
					</a>
					<nav class="nav-links" aria-label="Primary navigation">
						<a href={docsHref}>Docs</a>
						<a href={quickstartHref}>Quickstart</a>
						<a href="https://github.com/digablesolutions/luotsi/releases">Releases</a>
						<a href="https://github.com/digablesolutions/luotsi">GitHub</a>
					</nav>
				</header>

				<section class="hero">
					<div class="hero-copy">
						<div class="eyebrow">ADB-first tooling for real Android labs</div>
						<h1 class="display">Mirror the device. Inspect the UI. Replay the failure.</h1>
						<p class="lede">
							Luotsi keeps orchestration, policy, and diagnostics on the engineer or CI machine while the Android helper stays thin. Use it when you need a real-device workflow with operator control up front and durable artifacts at the end.
						</p>
						<div class="hero-actions">
							<a class="button-link button-link--primary" href={installHref}>Install Luotsi</a>
							<a class="button-link button-link--secondary" href={quickstartHref}>Read the quickstart</a>
						</div>
						<div class="hero-support">
							<div class="support-card">
								<strong>One tool</strong>
								<span>Live view, inspect, scenarios, and replay all stay in the same host-side runtime.</span>
							</div>
							<div class="support-card">
								<strong>One first command</strong>
								<span><code>luotsi doctor --device &lt;serial&gt; --fix</code> is the fastest way to prove the device path is ready.</span>
							</div>
						</div>
					</div>

					<div class="proof-composite">
						<div class="proof-device">
							<div class="proof-window-bar">
								<span>Live mirror</span>
								<span>Physical Android device</span>
							</div>
							<img src={heroImage} alt="Buggy Controller running on a real Android device during a Luotsi session." />
						</div>
						<div class="proof-status">
							{proofStatus.map((item) => (
								<div class="proof-status-pill">
									<span>{item.label}</span>
									<strong>{item.value}</strong>
								</div>
							))}
						</div>
						<div class="proof-grid">
							<article class="proof-card">
								<div class="proof-card__label">Inspect JSONL</div>
								<pre><code>{inspectSnippet.join('\n')}</code></pre>
							</article>
							<article class="proof-card proof-card--replay">
								<div class="proof-card__label">Replay bundle</div>
								<pre><code>{replaySnippet.join('\n')}</code></pre>
							</article>
						</div>
						<div class="proof-badges">
							{proofBadges.map((badge) => (
								<div class="proof-badge">
									<strong>{badge.title}</strong>
									<span>{badge.copy}</span>
								</div>
							))}
						</div>
					</div>
				</section>

				<section class="section">
					<div class="section-header">
						<div>
							<div class="section-kicker">Start fast</div>
							<h2 class="section-title">Get to a real device workflow in five minutes.</h2>
						</div>
						<p class="section-copy">
							Install from releases, run doctor once, then jump into the workflow that matches the job.
						</p>
					</div>
					<div class="launch-grid">
						{installPaths.map((path) => (
							<article class="launch-card">
								<div class="launch-card__meta">{path.title}</div>
								<p>{path.body}</p>
								<pre><code>{path.command}</code></pre>
							</article>
						))}
						<article class="launch-card launch-card--command">
							<div class="launch-card__meta">First useful command</div>
							<p>Run the environment check before you spend time on adb, helper, or decoder edge cases.</p>
							<pre><code>{`luotsi doctor --device <serial> --fix`}</code></pre>
							<ul>
								<li>Verifies adb visibility and device readiness.</li>
								<li>Checks live-view prerequisites.</li>
								<li>Stages helper and decoder assets Luotsi owns when possible.</li>
							</ul>
							<a class="inline-link" href={quickstartHref}>Open the quickstart -&gt;</a>
						</article>
					</div>
				</section>

				<section class="section">
					<div class="section-header">
						<div>
							<div class="section-kicker">Choose a workflow</div>
							<h2 class="section-title">Pick the route that matches the job.</h2>
						</div>
						<p class="section-copy">
							Once a device is attached, most work falls into one of these three paths.
						</p>
					</div>
					<div class="route-grid">
						{workflowRoutes.map((route) => (
							<a class="route-card" href={route.href}>
								<div class="route-card__eyebrow">{route.cta}</div>
								<strong>{route.title}</strong>
								<span>{route.summary}</span>
								<code>{route.command}</code>
							</a>
						))}
					</div>
				</section>

				<section class="section">
					<div class="section-header">
						<div>
							<div class="section-kicker">Go deeper</div>
							<h2 class="section-title">Docs organized by intent, not by dump.</h2>
						</div>
						<p class="section-copy">
							Start from the bucket that matches the moment: setup, run, or debug.
						</p>
					</div>
					<div class="bucket-grid">
						{docsBuckets.map((bucket) => (
							<section class="bucket-card">
								<div class="bucket-card__eyebrow">{bucket.title}</div>
								<p>{bucket.intro}</p>
								<ul class="bucket-list">
									{bucket.items.map((item) => (
										<li><a href={item.href}>{item.label}</a></li>
									))}
								</ul>
							</section>
						))}
					</div>
					<div class="utility-strip">
						{utilityLinks.map((link) => (
							<a class="utility-link" href={link.href}>{link.label}</a>
						))}
					</div>
				</section>

				<footer class="site-footer">
					<p>Luotsi is built in the open at <a href="https://github.com/digablesolutions/luotsi">digablesolutions/luotsi</a>.</p>
					<p>Use the docs hub for onboarding and workflows, then GitHub for releases, source, and contributor detail.</p>
				</footer>
			</div>
		</main>
	</body>
</html>