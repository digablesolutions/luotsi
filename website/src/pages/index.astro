---
import '../styles/site.css';

const siteUrl = Astro.site ?? new URL('https://digablesolutions.github.io');
const base = import.meta.env.BASE_URL.endsWith('/')
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;

const pageUrl = new URL(base, siteUrl).toString();
const heroImage = `${base}images/buggy-commands.png`;
const heroImageUrl = new URL(heroImage, siteUrl).toString();
const docsHref = `${base}docs/`;
const docsUrl = new URL(docsHref, siteUrl).toString();
const installHref = `${base}docs/getting-started/installation/`;
const quickstartHref = `${base}docs/getting-started/quickstart/`;
const agentLoopHref = `${base}docs/core-workflows/agent-loop-example/`;
const githubHref = 'https://github.com/digablesolutions/luotsi';
const releasesHref = `${githubHref}/releases`;
const engineeringLeadHref = `${base}docs/use-cases/android-automation-for-engineering-leads/`;

const pageTitle = 'Luotsi | Android Device Automation And Replay For Agents And CI';
const pageDescription = 'Luotsi is a host-driven Android device automation and replay CLI for AI agents and CI. Inspect real devices over JSONL, run lab-coordinated scenarios, and debug from replay artifacts after the session ends.';
const keywordsContent = 'android automation cli, ai agent android automation, adb automation, android device replay, mobile test artifacts, android ci device lab, jsonl inspect session';

const softwareSchema = {
	'@context': 'https://schema.org',
	'@type': 'SoftwareApplication',
	name: 'Luotsi',
	description: pageDescription,
	url: pageUrl,
	image: heroImageUrl,
	applicationCategory: 'DeveloperApplication',
	operatingSystem: 'Windows, macOS, Linux',
	downloadUrl: releasesHref,
	codeRepository: githubHref,
	isAccessibleForFree: true,
	offers: {
		'@type': 'Offer',
		price: '0',
		priceCurrency: 'USD',
	},
	author: {
		'@type': 'Organization',
		name: 'Digable Solutions',
	},
	featureList: [
		'ADB-first Android real-device automation',
		'JSONL inspect sessions for agent loops',
		'Lab-safe scenario execution with device claims',
		'Replay-ready failure artifacts for CI and agents',
		'Live mirrored device view with host-side controls',
	],
	sameAs: [githubHref, docsUrl],
};

const installPaths = [
	{
		title: 'Windows',
		body: 'Run the release installer, then let doctor verify the device path before you burn time on setup drift.',
		command: `iex (irm https://github.com/digablesolutions/luotsi/releases/latest/download/luotsi-install.ps1)
luotsi doctor --device <serial> --fix`,
	},
	{
		title: 'macOS / Linux',
		body: 'Use the shell installer, then validate the same first-run path against the attached device.',
		command: `curl -fsSL https://github.com/digablesolutions/luotsi/releases/latest/download/luotsi-install.sh | sh
luotsi doctor --device <serial> --fix`,
	},
];

const workflowRoutes = [
	{
		href: `${base}docs/core-workflows/ai-agent-workflows/`,
		title: 'Give an agent device state',
		summary: 'Use inspect when an agent needs JSONL snapshots, command results, and screen deltas from a real Android device.',
		cta: 'Use inspect',
		command: 'luotsi inspect --device <serial>',
	},
	{
		href: `${base}docs/use-cases/android-ci-device-lab-workflows/`,
		title: 'Run CI on real devices',
		summary: 'Use run when the flow belongs in a checked-in scenario with reports, claims, and a durable artifact root.',
		cta: 'Use run',
		command: 'luotsi run --path scenarios --device <serial>',
	},
	{
		href: `${base}docs/core-workflows/replay-and-artifacts/`,
		title: 'Debug after the session',
		summary: 'Use replay when the device is gone but the artifacts still need to explain what happened.',
		cta: 'Use replay',
		command: 'luotsi replay open --artifacts ./artifacts/<run-id>',
	},
];

const positioningQuestions = [
	{
		question: 'Can my agent inspect and act on a real Android device?',
		answer: 'Yes. Start an inspect session, read JSONL screen snapshots and deltas, then send JSON commands such as wait_visible, tap_text, type_text, screenshot, and exit over stdin.',
		href: agentLoopHref,
		cta: 'Open the agent loop example',
		command: 'luotsi inspect --device <serial>',
	},
	{
		question: 'Can CI run this and leave useful evidence?',
		answer: 'Yes. Run scenario playbooks from the host, claim lab devices when needed, and keep JSON reports, JUnit, screenshots, hierarchy captures, logcat, telemetry, and governance signals under one artifact root.',
		href: `${base}docs/use-cases/android-ci-device-lab-workflows/`,
		cta: 'Open CI device lab workflows',
		command: 'luotsi run --path scenarios --device <serial> --report-junit junit.xml',
	},
	{
		question: 'Can I debug the failure after the device is gone?',
		answer: 'Yes. Replay commands read saved artifacts, summarize the run, build capsules, scrub timelines, query semantic graphs, cluster repeated failures, and draft follow-up scenarios.',
		href: `${base}docs/core-workflows/replay-and-artifacts/`,
		cta: 'Open replay and artifacts',
		command: 'luotsi replay open --artifacts ./artifacts/<run-id>',
	},
];

const docsBuckets = [
	{
		title: 'Start Here',
		intro: 'Get from install to a stable device session before you debug the app.',
		items: [
			{ label: 'Installation', href: installHref },
			{ label: 'Quickstart', href: quickstartHref },
			{ label: 'Device Readiness', href: `${base}docs/getting-started/device-readiness/` },
			{ label: 'Troubleshooting', href: `${base}docs/getting-started/troubleshooting/` },
		],
	},
	{
		title: 'Run Workflows',
		intro: 'Choose the surface that matches the job: operator control, structured exploration, or repeatable runs.',
		items: [
			{ label: 'Live View', href: `${base}docs/core-workflows/live-view/` },
			{ label: 'Inspect and Scenarios', href: `${base}docs/core-workflows/inspect-and-scenarios/` },
			{ label: 'AI Agent Workflows', href: `${base}docs/core-workflows/ai-agent-workflows/` },
			{ label: 'Agent Loop Example', href: agentLoopHref },
			{ label: 'Scenario Playbooks', href: `${base}docs/reference/scenario-playbooks/` },
			{ label: 'Wireless and Port Forwarding', href: `${base}docs/reference/wireless-and-port-forwarding/` },
		],
	},
	{
		title: 'Evaluate And Use Cases',
		intro: 'Start from the page that matches the evaluation question or workflow you are trying to standardize.',
		items: [
			{ label: 'For Engineering Leads', href: engineeringLeadHref },
			{ label: 'When Luotsi Fits', href: `${base}docs/use-cases/when-luotsi-fits/` },
			{ label: 'Luotsi Alternatives And Comparison', href: `${base}docs/use-cases/luotsi-alternatives-and-comparison/` },
			{ label: 'AI Agent Android Automation', href: `${base}docs/use-cases/ai-agent-android-automation/` },
			{ label: 'Android CI Device Lab Workflows', href: `${base}docs/use-cases/android-ci-device-lab-workflows/` },
			{ label: 'Replay-Driven Triage', href: `${base}docs/use-cases/replay-driven-triage/` },
			{ label: 'Live Remote Device Inspection', href: `${base}docs/use-cases/live-remote-device-inspection/` },
			{ label: 'Scenario-Based Automation', href: `${base}docs/use-cases/scenario-based-android-automation/` },
		],
	},
	{
		title: 'Debug And Integrate',
		intro: 'Use the artifact layer and command surface when the question is no longer just how to start.',
		items: [
			{ label: 'Replay and Artifacts', href: `${base}docs/core-workflows/replay-and-artifacts/` },
			{ label: 'CLI Command Groups', href: `${base}docs/reference/cli-command-groups/` },
			{ label: 'Output Envelopes', href: `${base}docs/reference/output-envelopes/` },
		],
	},
];

const proofStatus = [
	{ label: 'Mode', value: 'Host-driven' },
	{ label: 'Device', value: 'Physical Android' },
	{ label: 'Evidence', value: 'Replay-ready' },
];

const utilityLinks = [
	{ label: 'For Engineering Leads', href: engineeringLeadHref },
	{ label: 'AI Agent Workflows', href: `${base}docs/core-workflows/ai-agent-workflows/` },
	{ label: 'Agent Loop Example', href: agentLoopHref },
	{ label: 'Architecture', href: `${base}docs/concepts/architecture/` },
	{ label: 'Subsystems', href: `${base}docs/concepts/subsystems/` },
	{ label: 'Contribution Guide', href: `${base}docs/contributing/guide/` },
	{ label: 'Releases', href: releasesHref },
	{ label: 'GitHub', href: githubHref },
];

const proofBadges = [
	{ title: 'Real device', copy: 'A physical Android screen under test, not a browser mock.' },
	{ title: 'Structured sessions', copy: 'Inspect and view emit machine-readable state instead of terminal prose.' },
	{ title: 'Replay artifacts', copy: 'Every run leaves behind a trail you can inspect after the session ends.' },
];

const trustSignals = [
	'Open source CLI',
	'ADB-first',
	'JSONL control plane',
	'CI artifact trail',
];

const inspectSnippet = [
	'{"type":"session_started","session_id":"...","started_at":"..."}',
	'{"type":"screen_snapshot","session_id":"...","state":{"captured_at":"...","element_count":18,"elements":[...]}}',
	'{"type":"command_result","id":"2","command":"tap_text","ok":true}',
];

const replaySnippet = [
	'artifact_root: ./artifacts/smoke-run',
	'timeline: session-timeline.jsonl',
	'summary: session-replay.json',
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{pageTitle}</title>
		<meta name="description" content={pageDescription} />
		<meta name="keywords" content={keywordsContent} />
		<meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
		<link rel="canonical" href={pageUrl} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={pageDescription} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={pageUrl} />
		<meta property="og:site_name" content="Luotsi" />
		<meta property="og:image" content={heroImageUrl} />
		<meta property="og:image:alt" content="Luotsi mirroring a real Android device with inspect JSONL and replay artifacts." />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={pageDescription} />
		<meta name="twitter:image" content={heroImageUrl} />
		<meta name="twitter:image:alt" content="Luotsi mirroring a real Android device with inspect JSONL and replay artifacts." />
		<script is:inline type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
		<link rel="icon" type="image/svg+xml" href={`${base}luotsi-mark.svg`} />
	</head>
	<body>
		<main class="landing-page">
			<div class="landing-shell">
				<header class="topbar">
					<a class="brand" href={base}>
						<img src={`${base}luotsi-mark.svg`} alt="Luotsi" />
						<span class="brand__text">
							Luotsi
							<span class="brand__subtext">Android automation and replay</span>
						</span>
					</a>
					<nav class="nav-links" aria-label="Primary navigation">
						<a href={docsHref}>Docs</a>
						<a href={quickstartHref}>Quickstart</a>
						<a href={agentLoopHref}>Agent loop</a>
						<a href={releasesHref}>Releases</a>
						<a href={githubHref}>GitHub</a>
					</nav>
				</header>

				<section class="hero">
					<div class="hero-copy">
						<div class="eyebrow">Real-device Android automation for agents and CI</div>
						<h1 class="display">The control plane for Android work that has to leave evidence.</h1>
						<p class="lede">
							Luotsi gives agents, engineers, and CI runners a host-driven way to inspect physical devices, run governed scenarios, and replay failures from durable artifacts after the device session is gone.
						</p>
						<div class="hero-actions">
							<a class="button-link button-link--primary" href={installHref}>Install Luotsi</a>
							<a class="button-link button-link--secondary" href={agentLoopHref}>See the agent loop</a>
						</div>
						<div class="trust-strip" role="list" aria-label="Luotsi product signals">
							{trustSignals.map((signal) => (
								<span role="listitem">{signal}</span>
							))}
						</div>
						<div class="hero-support">
							<div class="support-card">
								<strong>Beyond screen sharing</strong>
								<span>Live view is one surface in a workflow that also emits state, reports, and replay artifacts.</span>
							</div>
							<div class="support-card">
								<strong>Evidence layer, not another farm</strong>
								<span>Luotsi is the host-side evidence and control layer around real Android device runs.</span>
							</div>
						</div>
					</div>

					<div class="proof-composite">
						<div class="proof-command">
							<div class="proof-command__header">
								<span>operator console</span>
								<strong>ready</strong>
							</div>
							<pre><code>{`$ luotsi inspect --device pixel-lab-3
session: real-device JSONL
actions: tap_text, wait_visible, screenshot

$ luotsi replay open --artifacts ./artifacts/smoke-run
capsule: screenshots, hierarchy, logcat, junit`}</code></pre>
						</div>
						<div class="proof-device">
							<div class="proof-window-bar">
								<span>Live mirror</span>
								<span>Physical Android device</span>
							</div>
							<img src={heroImage} alt="Buggy Controller running on a real Android device during a Luotsi session." />
						</div>
						<div class="proof-status">
							{proofStatus.map((item) => (
								<div class="proof-status-pill">
									<span>{item.label}</span>
									<strong>{item.value}</strong>
								</div>
							))}
						</div>
						<div class="proof-grid">
							<article class="proof-card">
								<div class="proof-card__label">Inspect JSONL</div>
								<pre><code>{inspectSnippet.join('\n')}</code></pre>
							</article>
							<article class="proof-card proof-card--replay">
								<div class="proof-card__label">Replay bundle</div>
								<pre><code>{replaySnippet.join('\n')}</code></pre>
							</article>
						</div>
						<div class="proof-badges">
							{proofBadges.map((badge) => (
								<div class="proof-badge">
									<strong>{badge.title}</strong>
									<span>{badge.copy}</span>
								</div>
							))}
						</div>
					</div>
				</section>

				<section class="section">
					<div class="section-header">
						<div>
							<div class="section-kicker">Positioning</div>
							<h2 class="section-title">Three questions the tool has to answer.</h2>
						</div>
						<p class="section-copy">
							Luotsi is useful when the answer needs to be a machine-readable device session and a durable artifact trail, not just a live screen or a pass/fail bit.
						</p>
					</div>
					<div class="question-grid">
						{positioningQuestions.map((item) => (
							<article class="question-card">
								<h3>{item.question}</h3>
								<p>{item.answer}</p>
								<code>{item.command}</code>
								<a class="inline-link" href={item.href}>{item.cta} -&gt;</a>
							</article>
						))}
					</div>
				</section>

				<section class="section">
					<div class="section-header">
						<div>
							<div class="section-kicker">Start fast</div>
							<h2 class="section-title">Get to a real device workflow in five minutes.</h2>
						</div>
						<p class="section-copy">
							Install from releases, run doctor once, then jump into the workflow that matches the job.
						</p>
					</div>
					<div class="launch-grid">
						{installPaths.map((path) => (
							<article class="launch-card">
								<div class="launch-card__meta">{path.title}</div>
								<p>{path.body}</p>
								<pre><code>{path.command}</code></pre>
							</article>
						))}
						<article class="launch-card launch-card--command">
							<div class="launch-card__meta">First useful command</div>
							<p>Run the environment check before you spend time on adb, helper, or decoder edge cases.</p>
							<pre><code>{`luotsi doctor --device <serial> --fix`}</code></pre>
							<ul>
								<li>Verifies adb visibility and device readiness.</li>
								<li>Checks live-view prerequisites.</li>
								<li>Stages helper and decoder assets Luotsi owns when possible.</li>
							</ul>
							<a class="inline-link" href={quickstartHref}>Open the quickstart -&gt;</a>
						</article>
					</div>
				</section>

				<section class="section">
					<div class="section-header">
						<div>
							<div class="section-kicker">Choose a workflow</div>
							<h2 class="section-title">Pick the route that matches the job.</h2>
						</div>
						<p class="section-copy">
							Once a device is attached, most work falls into one of these three paths.
						</p>
					</div>
					<div class="route-grid">
						{workflowRoutes.map((route) => (
							<a class="route-card" href={route.href}>
								<div class="route-card__eyebrow">{route.cta}</div>
								<strong>{route.title}</strong>
								<span>{route.summary}</span>
								<code>{route.command}</code>
							</a>
						))}
					</div>
				</section>

				<section class="section">
					<div class="section-header">
						<div>
							<div class="section-kicker">Go deeper</div>
							<h2 class="section-title">Docs organized by intent, not by dump.</h2>
						</div>
						<p class="section-copy">
							Start from the bucket that matches the moment: setup, run, or debug.
						</p>
					</div>
					<div class="bucket-grid">
						{docsBuckets.map((bucket) => (
							<section class="bucket-card">
								<div class="bucket-card__eyebrow">{bucket.title}</div>
								<p>{bucket.intro}</p>
								<ul class="bucket-list">
									{bucket.items.map((item) => (
										<li><a href={item.href}>{item.label}</a></li>
									))}
								</ul>
							</section>
						))}
					</div>
					<div class="utility-strip">
						{utilityLinks.map((link) => (
							<a class="utility-link" href={link.href}>{link.label}</a>
						))}
					</div>
				</section>

				<footer class="site-footer">
					<p>Luotsi is built in the open at <a href="https://github.com/digablesolutions/luotsi">digablesolutions/luotsi</a>.</p>
					<p>Use the docs hub for onboarding and workflows, then GitHub for releases, source, and contributor detail.</p>
				</footer>
			</div>
		</main>
	</body>
</html>
