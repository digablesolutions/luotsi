{
  "name": "idle-language-switch-finnish",
  "steps": [
    { "name": "english selector visible", "action": "waitVisible", "text": "English", "timeoutSec": 10 },
    { "name": "sign in visible", "action": "waitVisible", "text": "Sign in", "timeoutSec": 10 },
    { "name": "open language selector", "action": "tapText", "text": "English", "timeoutSec": 10 },
    { "name": "switch to finnish", "action": "tapText", "text": "Suomi", "timeoutSec": 10 },
    { "name": "localized sign in visible", "action": "waitVisible", "text": "Kirjaudu sisään", "timeoutSec": 10 },
    { "name": "english label disappears", "action": "waitNotVisible", "text": "Sign in", "timeoutSec": 2 },
    { "name": "reopen language selector", "action": "tapText", "text": "Suomi", "timeoutSec": 10 },
    { "name": "switch back to english", "action": "tapText", "text": "English", "timeoutSec": 10 },
    { "name": "english sign in restored", "action": "waitVisible", "text": "Sign in", "timeoutSec": 10 }
  ]
}
