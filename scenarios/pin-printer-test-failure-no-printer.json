{
  "name": "pin-printer-test-failure-no-printer",
  "steps": [
    { "name": "maintenance action visible", "action": "waitVisible", "text": "Maintenance", "timeoutSec": 10 },
    { "name": "clear logs", "action": "resetLog" },
    { "name": "open maintenance", "action": "tapText", "text": "Maintenance", "timeoutSec": 15 },
    { "name": "no printer found visible", "action": "waitVisible", "text": "No printer found", "timeoutSec": 30 },
    { "name": "capture no printer screenshot", "action": "takeScreenshot", "label": "printer-test-no-printer-found" },
    { "name": "no printer event logged", "action": "assertEvent", "event": "PRINTER_TEST_FAILURE", "contains": ["eloSerial=", "no_printer_found"], "timeoutSec": 30 },
    { "name": "return to pin setup", "action": "tapText", "text": "Back", "timeoutSec": 10 },
    { "name": "maintenance action restored", "action": "waitVisible", "text": "Maintenance", "timeoutSec": 10 }
  ]
}
