{
  "name": "idle-visitor-sign-in-happy-path",
  "variables": {
    "visitorCategory": "Visitor\nI am here to attend a meeting, tour, event, or other short-term visit",
    "visitorFirstName": "Ggg",
    "visitorLastName": "Systam${now:HHmmss}",
    "visitorFullName": "${var:visitorFirstName} ${var:visitorLastName}",
    "visitorSearchText": "${var:visitorFullName}",
    "hostSearchText": "${env:LUOTSI_HOST_SEARCH|per}",
    "hostName": "${env:LUOTSI_HOST_NAME|Perttu Sliden}"
  },
  "steps": [
    { "name": "idle sign in visible", "action": "waitVisible", "text": "Sign in", "timeoutSec": 15 },
    { "name": "clear logs", "action": "resetLog" },
    { "name": "open sign in area", "action": "tapPoint", "label": "idle-sign-in", "xRatio": 0.5, "yRatio": 0.614, "postTapDelayMs": 500 },
    { "name": "choose no pin details flow", "action": "tapPoint", "label": "pin-no-details", "xRatio": 0.602, "yRatio": 0.581, "postTapDelayMs": 500 },
    { "name": "select visitor category", "action": "tapText", "text": "${var:visitorCategory}", "timeoutSec": 15 },
    { "name": "details input ready", "action": "assertTextInputReady", "requireKeyboard": true, "timeoutSec": 15 },
    { "name": "type visitor name", "action": "typeText", "text": "${var:visitorFullName}" },
    { "name": "focus mobile phone field", "action": "tapPoint", "label": "details-mobile-phone", "xRatio": 0.696, "yRatio": 0.172, "postTapDelayMs": 150 },
    { "name": "clear logs before continuing details", "action": "resetLog" },
    { "name": "continue details", "action": "tapPoint", "label": "details-continue", "xRatio": 0.5, "yRatio": 0.419, "postTapDelayMs": 50 },
    { "name": "agree to privacy policy", "action": "tapText", "text": "I agree to the privacy policy", "timeoutSec": 15 },
    { "name": "take photo", "action": "tapText", "text": "Take photo", "timeoutSec": 30 },
    { "name": "save photo", "action": "tapText", "text": "Save photo", "timeoutSec": 20 },
    { "name": "host selection visible", "action": "waitVisible", "text": "Who are you here to meet?", "timeoutSec": 20 },
    { "name": "type host search", "action": "typeText", "text": "${var:hostSearchText}" },
    { "name": "host visible", "action": "waitVisible", "text": "${var:hostName}", "timeoutSec": 15 },
    { "name": "select host", "action": "tapText", "text": "${var:hostName}", "timeoutSec": 15 },
    { "name": "clear logs before host continue", "action": "resetLog" },
    { "name": "continue after host", "action": "tapText", "text": "Continue", "timeoutSec": 15 },
    { "name": "agree to visit terms", "action": "tapText", "text": "I agree to the terms of visit", "timeoutSec": 15 },
    { "name": "additional visitors prompt", "action": "waitVisible", "text": "Would you like to add more visitors?", "timeoutSec": 15 },
    { "name": "clear logs before declining extras", "action": "resetLog" },
    { "name": "decline extra visitors", "action": "tapText", "text": "No", "timeoutSec": 15 },
    { "name": "printing succeeded", "action": "assertEvent", "event": "PRINTING_SUCCESSFUL", "timeoutSec": 60, "observeFromPreviousStep": true },
    { "name": "return to main page shortcut", "action": "tapText", "text": "Go to the main page", "timeoutSec": 8, "continueOnError": true },
    { "name": "sign out action visible", "action": "waitVisible", "text": "Sign out", "timeoutSec": 60 },
    { "name": "clear logs before sign out", "action": "resetLog" },
    { "name": "open sign out", "action": "tapText", "text": "Sign out", "timeoutSec": 15 },
    { "name": "sign out prompt visible", "action": "waitVisible", "text": "Enter your name to sign out", "timeoutSec": 15 },
    { "name": "search input ready", "action": "assertTextInputReady", "requireKeyboard": true, "timeoutSec": 10 },
    { "name": "type visitor search", "action": "typeText", "text": "${var:visitorSearchText}" },
    { "name": "visitor suggestion visible", "action": "waitVisible", "text": "${var:visitorFullName}", "timeoutSec": 45 },
    { "name": "select visitor suggestion", "action": "tapText", "text": "${var:visitorFullName}", "timeoutSec": 15 },
    { "name": "clear logs before final sign out", "action": "resetLog" },
    { "name": "confirm sign out", "action": "tapText", "text": "Sign out", "timeoutSec": 10 },
    { "name": "idle sign in restored", "action": "waitVisible", "text": "Sign in", "timeoutSec": 25 }
  ]
}
